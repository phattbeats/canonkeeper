    "3": {
      "uid": 3,
      "key": [
        "Wren"
      ],
      "keysecondary": [],
      "comment": "Wren",
      "content": "Wren is a Saltgate street runner who sells rumors by the copper and wears an oversized sailor's cap. She knows the Undercroft tunnels and kept the cartographer's workshop hidden in exchange for sweets. She caused a scene on the docks so that Tamsin could escape, and she kept watch at the Undercroft grate during the rescue.",
