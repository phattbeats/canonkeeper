    "6": {
      "uid": 6,
      "key": [
        "Dovrin Kesh",
        "Kesh",
        "Magistrate"
      ],
      "keysecondary": [],
      "comment": "Dovrin Kesh",
      "content": "Magistrate Dovrin Kesh rules Saltgate's courts from a white marble hall. He is a narrow man with ink-stained fingers, pale eyes and a silver chain of office. He enforces a tariff on boats passing the harbor chain and wants every tide chart burned. His men started the Harbor Fire, and he held Ines Vell for a treason trial whose sentence would have been drowning.",
